# Copy to .env.local for local development. On cPanel, add these in "Setup Node.js App" → Environment variables.

# Public URL of the site (used for SEO: canonical links, sitemap, social previews)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# MongoDB Atlas connection string (free tier works). Without it the site uses the built-in data in /data
# and the admin panel / contact inbox are disabled.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority

# Admin panel at /admin
ADMIN_PASSWORD=choose-a-long-password
# Random string, 32+ characters, used to sign the admin login cookie
ADMIN_SECRET=replace-with-a-long-random-string-0123456789

# Contact form email notifications via https://resend.com (optional)
RESEND_API_KEY=
# Where enquiries are sent (defaults to the email in data/site.json)
CONTACT_TO=abdulmoizghani500@gmail.com
# Sender — must be a domain verified in Resend; onboarding@resend.dev works for testing
CONTACT_FROM=Portfolio <onboarding@resend.dev>
